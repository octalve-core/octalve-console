[Unit]
Description=Octalve Django API
After=network-online.target
Wants=network-online.target

[Service]
User=octalve
Group=octalve
WorkingDirectory=/srv/octalve/backend
EnvironmentFile=/etc/octalve/backend.env
ExecStart=/srv/octalve/.venv/bin/gunicorn octalve_backend.wsgi:application --bind 127.0.0.1:8000 --workers 2 --timeout 120
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
