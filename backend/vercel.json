{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": false,
      "review/cloud": false,
      "*": false
    }
  },
  "crons": [
    {
      "path": "/api/payments/test-lifecycle/cron/",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/provisioning/hosting-staging/cron/",
      "schedule": "15 3 * * *"
    },
    {
      "path": "/api/provisioning/hosting-usage/cron/",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/settings/console-mail/delivery/cron/",
      "schedule": "45 3 * * *"
    },
    {
      "path": "/api/payments/live-reconciliation/cron/",
      "schedule": "0 4 * * *"
    }
  ]
}
