# Octalve Console frontend environment

# Backend API root.
# Example local:
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api
# Example production:
# NEXT_PUBLIC_API_BASE_URL=https://api.octalve.cloud/api
NEXT_PUBLIC_API_BASE_URL=

# Frontend app URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional build/version label.
NEXT_PUBLIC_APP_VERSION=development